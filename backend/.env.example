# ===== SERVER =====
PORT=5000
NODE_ENV=development

# ===== DATABASE (PostgreSQL) =====
# We connect as a dedicated app role (NOT the postgres superuser) so the
# backend only has the permissions it actually needs. See database/README.md
# to create this role - it's created for you if you run database/setup.sh.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pdf_ai_assistant
DB_USER=pdf_app_user
DB_PASSWORD=dev_password_123

# ===== JWT AUTH =====
# Use a long, random string in production (e.g. generate with `openssl rand -hex 32`)
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ===== BCRYPT =====
BCRYPT_SALT_ROUNDS=10

# ===== FILE UPLOAD =====
UPLOAD_DIR=src/uploads
MAX_FILE_SIZE_MB=20

# ===== OLLAMA (local AI, no external API calls) =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ===== CHROMADB (local vector database) =====
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=pdf_chunks
